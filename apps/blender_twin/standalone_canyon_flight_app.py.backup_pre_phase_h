class OT_CanyonTacticalFlightSim(bpy.types.Operator):
    bl_idname  = "view3d.canyon_tactical_flight_sim"
    bl_label   = "Top Gun Maverick Tactical Canyon Simulator"
    _timer     = None
    _handle_2d = None

    def modal(self, context, event):
        st = flight_state

        if event.type == 'ESC':
            self.cancel(context)
            return {'CANCELLED'}

        pressed = event.value == 'PRESS'
        released = event.value == 'RELEASE'

        # Consume all mouse movement/clicks so moving the cursor never moves the camera or viewport
        if event.type in {'MOUSEMOVE', 'INBETWEEN_MOUSEMOVE', 'MIDDLEMOUSE', 'WHEELUPMOUSE', 'WHEELDOWNMOUSE',
                          'TRACKPADPAN', 'TRACKPADZOOM', 'LEFTMOUSE', 'RIGHTMOUSE'}:
            return {'RUNNING_MODAL'}

        # Stick inputs (held keys)
        if event.type in {'W', 'UP_ARROW'}:
            st.inp_pitch_up = pressed
            return {'RUNNING_MODAL'}
        elif event.type in {'S', 'DOWN_ARROW'}:
            st.inp_pitch_down = pressed
            return {'RUNNING_MODAL'}
        elif event.type in {'A', 'LEFT_ARROW'}:
            st.inp_turn_left = pressed
            return {'RUNNING_MODAL'}
        elif event.type in {'D', 'RIGHT_ARROW'}:
            st.inp_turn_right = pressed
            return {'RUNNING_MODAL'}

        # Continuous Throttle Controls
        if event.type in {'E', 'PAGE_UP'}:
            st.inp_throttle_up = pressed
            return {'RUNNING_MODAL'}
        elif event.type in {'Q', 'PAGE_DOWN'}:
            st.inp_throttle_down = pressed
            return {'RUNNING_MODAL'}

        # Space: Pause
        elif event.type == 'SPACE' and pressed:
            st.is_paused = not st.is_paused
            st.add_log(f"[SIM] Simulation {'PAUSED' if st.is_paused else 'RESUMED'}.", (0.9, 0.9, 0.0, 1.0))
            return {'RUNNING_MODAL'}

        # DRDO Fault Injections & Test Hotkeys
        elif event.type in {'ONE', 'NUMPAD_1'} and pressed:
            st.fault_overheat = not st.fault_overheat
            if st.fault_overheat:
                st.tactical_dive_active = True
                st.dive_phase = "SEEK_CANYON"
                # Scan for the widest OPEN GROUND valley ahead of current flight path (NO HARDCODED LEFT TURN!)
                best_hdg, floor_z, open_w = find_open_ground_corridor(st.pos, st.heading_rad, radar)
                st.dive_target_bearing = best_hdg
                st.target_canyon_alt = max(3950.0, floor_z)
                hdg_disp = (math.degrees(best_hdg) + 360.0) % 360.0
                turn_deg = math.degrees((best_hdg - st.heading_rad + math.pi) % (2.0 * math.pi) - math.pi)
                st.add_log(f"[OPEN GROUND SCANNER] Cyl #2 CHT Overheat! Wide valley locked at HDG {hdg_disp:.0f}° (Turn {turn_deg:+.0f}°, Width {open_w:.0f}m). Commencing dive!", (1.0, 0.2, 0.2, 1.0))
                st.ai_status = f"SCANNER: OPEN VALLEY {hdg_disp:.0f}°"
                st.ai_color = (1.0, 0.45, 0.0, 1.0)
            else:
                st.tactical_dive_active = False
                st.dive_phase = "IDLE"
                st.add_log("[FADEC] Cyl #2 thermal fault cleared.", (0.0, 0.95, 0.4, 1.0))
            return {'RUNNING_MODAL'}

        elif event.type in {'TWO', 'NUMPAD_2'} and pressed:
            st.fault_oil_loss = not st.fault_oil_loss
            if st.fault_oil_loss:
                st.add_log("[FADEC FAULT 04] Scavenge Pump Pressure Loss (< 2.0 bar). Derate recommended.", (1.0, 0.6, 0.0, 1.0))
                st.ai_status = "FADEC: OIL PRESSURE LOSS"
                st.ai_color = (1.0, 0.6, 0.0, 1.0)
            else:
                st.oil_p_bar = 4.20
                st.add_log("[FADEC] Oil pressure restored to 4.20 bar.", (0.0, 0.95, 0.4, 1.0))
            return {'RUNNING_MODAL'}

        elif event.type in {'THREE', 'NUMPAD_3'} and pressed:
            st.fault_injector = not st.fault_injector
            if st.fault_injector:
                st.add_log("[FADEC FAULT 02] Injector #1 Clog. Lean misfire. Switching to Lane B.", (1.0, 0.6, 0.0, 1.0))
                st.ai_status = "FADEC: INJECTOR CLOG (LANE B)"
                st.ai_color = (1.0, 0.6, 0.0, 1.0)
            else:
                st.rpm_jitter = 0.0
                st.add_log("[FADEC] Injector fault cleared. Lane A restored.", (0.0, 0.95, 0.4, 1.0))
            return {'RUNNING_MODAL'}

        elif event.type in {'ZERO', 'NUMPAD_0'} and pressed:
            st.fault_overheat = False
            st.fault_oil_loss = False
            st.fault_injector = False
            st.tactical_dive_active = False
            st.dive_phase = "IDLE"
            st.rpm_jitter = 0.0
            st.oil_p_bar = 4.20
            st.add_log("[FADEC] ALL ENGINE FAULTS CLEARED. Nominal flight.", (0.0, 0.95, 0.4, 1.0))
            st.ai_status = "NOMINAL TRANSIT"
            st.ai_color = (0.0, 0.95, 0.4, 1.0)
            return {'RUNNING_MODAL'}

        elif event.type == 'K' and pressed:
            # Immediate CFIT Crash trigger for Judges Demonstration
            uav = bpy.data.objects.get(UAV_NAME)
            _trigger_crash_event(st, uav, impact_type="SIMULATED CFIT IMPACT")
            return {'RUNNING_MODAL'}

        # Hotkey P / C: Toggle Copilot Mode
        elif event.type in {'P', 'C'} and pressed:
            st.copilot_on = not st.copilot_on
            if st.copilot_on:
                st.add_log("[COPILOT] Auto-GCAS ARMED. Terrain safety override active.", (0.0, 0.95, 0.4, 1.0))
            else:
                st.add_log("[COPILOT] WARNING: Full manual authority. Auto-GCAS disabled.", (1.0, 0.3, 0.3, 1.0))
            return {'RUNNING_MODAL'}

        # Hotkey R: Reset
        elif event.type == 'R' and pressed:
            self._reset_sim()
            return {'RUNNING_MODAL'}

        # 120 FPS Continuous Physics Timer Tick
        if event.type == 'TIMER':
            update_simulation(st)
            update_chase_camera(st)
            # 2 Hz post-mission telemetry capture — early-outs on an interval check, so
            # the per-frame cost here is one float compare.
            if mission_recorder is not None:
                mission_recorder.sample(st)
            # Continuous redraw across all 3D viewports
            for win in context.window_manager.windows:
                for area in win.screen.areas:
                    if area.type == 'VIEW_3D':
                        area.tag_redraw()
            return {'RUNNING_MODAL'}

        return {'RUNNING_MODAL'}

    def _reset_sim(self):
        st = flight_state
        uav = bpy.data.objects.get(UAV_NAME)
        cam = bpy.data.objects.get(CAM_NAME)
        fp = bpy.data.objects.get(PATH_NAME)

        # Hide corridor curve object (removes 3D path line)
        if fp:
            fp.hide_viewport = True
            fp.hide_render = True
            try:
                fp.hide_set(True)
            except Exception:
                pass

        # Clear keyframe animation and constraints (removes Damped Track dotted line)
        if cam:
            cam.constraints.clear()
            if cam.animation_data:
                cam.animation_data_clear()
            cam.scale = (1.0, 1.0, 1.0)
            cam.data.lens = 45.0
            cam.data.clip_start = 0.5
            cam.data.clip_end = 250000.0

        if uav:
            if uav.animation_data:
                uav.animation_data_clear()
            uav.scale = (UAV_PHYSICAL_SCALE, UAV_PHYSICAL_SCALE, UAV_PHYSICAL_SCALE)

        st.pos = INGRESS_POS.copy()
        st.heading_rad = math.radians(NOMINAL_HEADING_DEG)
        st.pitch_rad = 0.0
        st.roll_rad = 0.0
        st.speed_ms = CRUISE_SPEED_MS
        st.is_crashed = False
        st.crash_info = {}
        st.gcas_active = False
        st.gcas_clearing = False
        st.warning_active = False
        st.fault_overheat = False
        st.fault_oil_loss = False
        st.fault_injector = False
        st.tactical_dive_active = False
        st.dive_phase = "IDLE"
        st.diveable_terrain_found = False
        st.canyon_depth_m = 0.0
        st.rpm_jitter = 0.0
        st.throttle_pct = 80.0
        st.inp_throttle_up = False
        st.inp_throttle_down = False
        st.rpm = 5200.0
        st.cht_c = 104.2
        st.oil_p_bar = 4.20
        st.warn_cht_high = False
        st.cam_world_pos = None

        if uav:
            uav.location = st.pos
            # Reset orientation
            update_simulation(st)

        st.add_log(f"[SYSTEM] Reset to Nubra corridor ({INGRESS_POS.z:.0f}m AMSL, {DESIRED_CRUISE_AGL_M:.0f}m AGL).", (0.4, 0.8, 1.0, 1.0))

    def invoke(self, context, event):
        if context.area.type != 'VIEW_3D':
            return {'CANCELLED'}

        self._handle_2d = bpy.types.SpaceView3D.draw_handler_add(
            _draw_callback, (self, context), 'WINDOW', 'POST_PIXEL'
        )
        wm = context.window_manager
        # Pure 143 FPS Event Timer (1.0 / 143.0 s = 6.99 ms)
        self._timer = wm.event_timer_add(1.0 / 143.0, window=context.window)
        wm.modal_handler_add(self)

        self._reset_sim()
        # Pre-warm DEM BVH tree during scene launch so all in-flight raycasts are instantaneous
        radar.raycast(INGRESS_POS + mathutils.Vector((0, 0, 100.0)), mathutils.Vector((0, 0, -1.0)), 4000.0)
        global mission_recorder
        if FlightMissionRecorder is not None:
            try:
                mission_recorder = FlightMissionRecorder()
            except Exception:
                mission_recorder = None
        print(">>> Top Gun Maverick Canyon Simulator Active (Pure 143 FPS Native Physics) <<<")
        return {'RUNNING_MODAL'}

    def cancel(self, context):
        # Export the post-mission report bundle before tearing anything down. Wrapped
        # because a failed debrief must never stop the simulator from closing cleanly.
        global mission_recorder
        if mission_recorder is not None:
            try:
                path = mission_recorder.export(flight_state)
                if path:
                    print(f">>> Post-mission report bundle written: {path} <<<")
            except Exception as e:
                print(f"[NOTE] Report export skipped: {e}")
            mission_recorder = None

        if self._timer:
            context.window_manager.event_timer_remove(self._timer)
        if self._handle_2d:
            bpy.types.SpaceView3D.draw_handler_remove(self._handle_2d, 'WINDOW')
        for win in context.window_manager.windows:
            for area in win.screen.areas:
                if area.type == 'VIEW_3D':
                    area.tag_redraw()
        print(">>> Canyon Flight Simulator Closed. <<<")


