def update_simulation(st: FlightState):
    """Main physics and guidance tick (runs at pure 143 FPS)."""
    now = time.perf_counter()
    dt = now - st.last_tick_wall
    dt = max(0.001, min(dt, 0.025))   # clamp 1ms … 25ms
    st.last_tick_wall = now

    if st.is_paused or st.is_crashed:
        return

    uav = bpy.data.objects.get(UAV_NAME)
    if uav is None:
        return

    # ── 1. SENSING: Multi-Beam Terrain Radar Probing ───────────────────────────
    # Nominal horizontal forward vector from current heading
    cos_hdg = math.cos(st.heading_rad)
    sin_hdg = math.sin(st.heading_rad)
    # Heading 0 deg = North (+Y). Heading 90 deg = East (+X).
    fwd_horiz = mathutils.Vector((math.sin(st.heading_rad), math.cos(st.heading_rad), 0.0)).normalized()

    # Full 3D forward vector including pitch
    cos_pit = math.cos(st.pitch_rad)
    sin_pit = math.sin(st.pitch_rad)
    fwd_3d = mathutils.Vector((
        fwd_horiz.x * cos_pit,
        fwd_horiz.y * cos_pit,
        sin_pit
    )).normalized()

    # Lateral vectors
    right_horiz = mathutils.Vector((fwd_horiz.y, -fwd_horiz.x, 0.0)).normalized()
    left_horiz = -right_horiz

    # ── 1. SENSING: Low-Overhead 143 FPS Radar Probing ────────────────────────
    st.tick_count = getattr(st, 'tick_count', 0) + 1
    probe_origin = st.pos + mathutils.Vector((0.0, 0.0, 2.0))

    # Stagger raycasts across 12 slots so 67% of frames have ZERO raycasts (0.0 ms)
    # On non-probing frames, ground altitude is computed analytically from last_ground_z
    slot = st.tick_count % 12
    if slot == 0:
        # Downward AGL probe (~12 Hz)
        hit_dn, loc_dn, agl, _ = radar.raycast(probe_origin, mathutils.Vector((0.0, 0.0, -1.0)), 8000.0)
        if hit_dn:
            st.last_ground_z = loc_dn.z
            st.agl_m = agl
    elif slot == 6:
        # Forward center obstacle probe (~12 Hz)
        hit_fwd, _, dist_fwd, _ = radar.raycast(probe_origin, fwd_3d, MAX_RADAR_DIST)
        st.fwd_dist_m = dist_fwd if hit_fwd else MAX_RADAR_DIST
    elif slot == 3:
        # Forward-down pitch-warning probe (~12 Hz)
        fwd_dn = (fwd_horiz * 0.95 + mathutils.Vector((0.0, 0.0, -0.31))).normalized()
        hit_fd, _, dist_fd, _ = radar.raycast(probe_origin, fwd_dn, 3500.0)
        st.dist_fd_m = dist_fd if hit_fd else 3500.0
    elif slot == 9:
        # Lateral wall probes (~12 Hz)
        hit_l, _, dist_l, _ = radar.raycast(probe_origin, (fwd_horiz * 0.7 + left_horiz * 0.7).normalized(), 4000.0)
        hit_r, _, dist_r, _ = radar.raycast(probe_origin, (fwd_horiz * 0.7 + right_horiz * 0.7).normalized(), 4000.0)
        if hit_l: st.left_dist_m = dist_l
        if hit_r: st.right_dist_m = dist_r

    # Analytical real-time AGL on all interim frames (continuous 143 Hz tape updates)
    if hasattr(st, 'last_ground_z'):
        st.agl_m = max(5.0, st.pos.z - st.last_ground_z)

    dist_fd = getattr(st, 'dist_fd_m', 3500.0)

    # Dynamic Time-To-Impact (TTI) and Stopping Margin
    closure_speed = max(10.0, st.speed_ms * cos_pit)
    if st.pitch_rad < -math.radians(3.0):
        st.tti_s = min(st.fwd_dist_m, dist_fd) / closure_speed
    else:
        st.tti_s = st.fwd_dist_m / closure_speed
    st.margin_dist_m = (st.speed_ms ** 2) / (2.0 * 24.5)   # stopping distance margin

    # ── 2. AUTO-GCAS SAFETY GATE ──────────────────────────────────────────────
    # ── 2. AUTO-GCAS SAFETY GATE ──────────────────────────────────────────────
    if st.copilot_on and not st.tactical_dive_active:
        # Check if aircraft breached safe margin during manual/cruise flight
        is_critical = (st.tti_s <= GCAS_RECOVER_TTI_S) or (st.agl_m <= MIN_SAFE_AGL_M)

        if is_critical or st.gcas_clearing:
            st.gcas_active = True
            # Emergency 2.5G pull-up override:
            target_pitch = MAX_PITCH_UP_RAD
            st.pitch_rad = min(target_pitch, st.pitch_rad + RECOVERY_PULL_RADS * dt)
            st.roll_rad *= max(0.0, 1.0 - 5.0 * dt)   # wings level immediately
            st.rpm = min(5500.0, st.rpm + 800.0 * dt) # spool full throttle

            # Lateral escape bias: steer towards clearer valley side
            if st.left_dist_m > st.right_dist_m + 50.0:
                st.heading_rad -= math.radians(15.0) * dt   # bank left away from right cliff
                st.roll_rad = max(-math.radians(18.0), st.roll_rad - 1.5 * dt)
            elif st.right_dist_m > st.left_dist_m + 50.0:
                st.heading_rad += math.radians(15.0) * dt   # bank right away from left cliff
                st.roll_rad = min(math.radians(18.0), st.roll_rad + 1.5 * dt)

            if is_critical:
                st.gcas_clearing = True
                st.add_log(f"[AUTO-GCAS] 2.5G PULL-UP! Obstacle {st.fwd_dist_m:.0f}m, TTI {st.tti_s:.1f}s!", (1.0, 0.2, 0.2, 1.0))
                st.ai_status = "AUTO-GCAS: EMERGENCY PULL-UP"
                st.ai_color = (1.0, 0.2, 0.2, 1.0)
            elif st.agl_m > MIN_SAFE_AGL_M + 50.0 and st.tti_s > GCAS_WARN_TTI_S:
                # Terrain cleared safely: hand control back
                st.gcas_active = False
                st.gcas_clearing = False
                st.add_log("[COPILOT] Terrain cleared. Resuming operator authority.", (0.0, 0.95, 0.4, 1.0))
                st.ai_status = "NOMINAL TRANSIT"
                st.ai_color = (0.0, 0.95, 0.4, 1.0)

        elif st.tti_s <= GCAS_WARN_TTI_S or st.agl_m <= MIN_SAFE_AGL_M + 80.0:
            # Amber warning zone: advisory alert, pilot retains authority
            st.gcas_active = False
            st.warning_active = True
            st.add_log(f"[WARNING] Terrain proximity ahead: {st.fwd_dist_m:.0f}m (TTI {st.tti_s:.1f}s).", (1.0, 0.7, 0.0, 1.0))
            st.ai_status = "WARNING: TERRAIN PROXIMITY"
            st.ai_color = (1.0, 0.7, 0.0, 1.0)

        else:
            # Green / Nominal regime
            st.gcas_active = False
            st.gcas_clearing = False
            st.warning_active = False
            if st.ai_status.startswith("WARNING") or st.ai_status.startswith("AUTO-GCAS"):
                st.ai_status = "NOMINAL TRANSIT"
                st.ai_color = (0.0, 0.95, 0.4, 1.0)

    else:
        # Copilot OFF or Tactical Dive Active: Do not override pitch with emergency pull-up
        st.gcas_active = False
        st.gcas_clearing = False

    # ── 3. PILOT INPUT & DYNAMIC POTENTIAL FIELD (APF) GUIDANCE ───────────────
    if not st.gcas_active:
        user_steering = False

        # Pitch control
        if st.inp_pitch_up:
            st.pitch_rad = min(MAX_PITCH_UP_RAD, st.pitch_rad + PITCH_RATE_RADS * dt)
            user_steering = True
        elif st.inp_pitch_down:
            st.pitch_rad = max(-MAX_PITCH_DOWN_RAD, st.pitch_rad - PITCH_RATE_RADS * dt)
            user_steering = True

        # Roll & Yaw turn control (coordinated turn)
        if st.inp_turn_left:
            st.heading_rad -= TURN_RATE_RADS * dt
            st.roll_rad = max(-MAX_BANK_RAD, st.roll_rad - 2.8 * dt)
            user_steering = True
        elif st.inp_turn_right:
            st.heading_rad += TURN_RATE_RADS * dt
            st.roll_rad = min(MAX_BANK_RAD, st.roll_rad + 2.8 * dt)
            user_steering = True
        else:
            # Wings level recovery
            st.roll_rad *= max(0.0, 1.0 - 3.5 * dt)

        # Autonomous APF corridor centering when pilot is not actively turning
        if not user_steering and not st.tactical_dive_active:
            # Canyon wall repulsion:
            wall_repulsion = 0.0
            if st.left_dist_m < 250.0:
                wall_repulsion += (250.0 - st.left_dist_m) / 250.0 * 0.6
            if st.right_dist_m < 250.0:
                wall_repulsion -= (250.0 - st.right_dist_m) / 250.0 * 0.6
            
            # Apply gentle centering yaw
            st.heading_rad += wall_repulsion * TURN_RATE_RADS * dt * 0.5
            st.roll_rad += wall_repulsion * MAX_BANK_RAD * dt * 0.8
            
            # Gentle pitch trim to follow nominal canyon descent/cruise
            if not st.inp_pitch_up and not st.inp_pitch_down:
                st.pitch_rad *= max(0.0, 1.0 - 1.5 * dt)

        # ── 3B. AUTONOMOUS TACTICAL CANYON DIVE & THERMAL RECOVERY ────────────
        if st.tactical_dive_active and not user_steering:
            corridor_bearing = getattr(st, 'dive_target_bearing', st.heading_rad)

            if st.dive_phase == "SEEK_CANYON":
                # Smoothly bank and align with the dynamically selected open valley corridor
                diff = (corridor_bearing - st.heading_rad + math.pi) % (2.0 * math.pi) - math.pi
                turn_step = math.copysign(min(abs(diff), TURN_RATE_RADS * dt * 2.0), diff)
                st.heading_rad += turn_step
                st.roll_rad = math.copysign(min(MAX_BANK_RAD, abs(diff) * 2.5), diff)

                depth = max(0.0, st.pos.z - getattr(st, 'last_ground_z', 4608.0))
                st.canyon_depth_m = depth

                # Once aligned with open valley axis (within 25 deg), initiate the dive!
                if abs(diff) < math.radians(25.0):
                    st.dive_phase = "DESCENT"
                    st.add_log(f"[TACTICAL DIVE] Open valley locked (HDG {math.degrees(corridor_bearing):.0f}°). Commencing steep dive!", (0.0, 0.95, 0.4, 1.0))
                    st.ai_status = "TACTICAL DIVE: GORGE DESCENT"
                    st.ai_color = (1.0, 0.45, 0.0, 1.0)
                else:
                    st.pitch_rad *= max(0.0, 1.0 - 2.0 * dt)
                    st.ai_status = f"SCANNER: ALIGNING VALLEY ({math.degrees(corridor_bearing):.0f}°)"

            elif st.dive_phase == "DESCENT":
                # 2. Command steep tactical dive (-18°) to plunge into the open valley!
                target_dive_pitch = math.radians(-18.0)
                st.pitch_rad += (target_dive_pitch - st.pitch_rad) * min(1.0, 4.0 * dt)
                # Roll back throttle to eco cooldown (4,000 RPM)
                st.throttle_pct = max(35.0, st.throttle_pct - 35.0 * dt)

                # Stable corridor centering: keeps UAV centered along open valley axis
                corridor_diff = (corridor_bearing - st.heading_rad + math.pi) % (2.0 * math.pi) - math.pi
                st.heading_rad += math.copysign(min(abs(corridor_diff), math.radians(14.0) * dt), corridor_diff)
                st.roll_rad = math.copysign(min(math.radians(22.0), abs(corridor_diff) * 2.0), corridor_diff)

                # Check when reaching canyon gorge floor elevation (below 4,150m AMSL or AGL <= 150m)
                if st.pos.z <= 4100.0 or (st.pos.z <= 4350.0 and st.agl_m <= 150.0):
                    st.dive_phase = "LEVEL_SPRINT"
                    st.add_log("[TACTICAL DIVE] Reached open valley floor! Maximum convective ram cooling active!", (0.0, 0.95, 0.4, 1.0))
                    st.ai_status = "CANYON SPRINT: RAM COOLING"
                    st.ai_color = (0.0, 0.85, 1.0, 1.0)
                    st.mission_phase = "CANYON GORGE SPRINT (3,950m)"

            elif st.dive_phase == "LEVEL_SPRINT":
                # 3. Level sprint through the open valley corridor at double speed
                target_floor = max(3100.0, min(4100.0, getattr(st, 'last_ground_z', 3950.0) + 85.0))
                alt_err = st.pos.z - target_floor
                st.pitch_rad = max(-math.radians(6.0), min(math.radians(7.0), -alt_err * 0.008))
                st.throttle_pct = min(80.0, st.throttle_pct + 30.0 * dt)

                # Lateral wall centering using existing radar measurements (Zero raycast overhead!)
                wall_balance = 0.0
                if hasattr(st, 'left_dist_m') and st.left_dist_m < 600.0:
                    wall_balance += (600.0 - st.left_dist_m) / 600.0 * 0.35
                if hasattr(st, 'right_dist_m') and st.right_dist_m < 600.0:
                    wall_balance -= (600.0 - st.right_dist_m) / 600.0 * 0.35
                st.heading_rad += wall_balance * math.radians(14.0) * dt

                # Stable corridor centering
                corridor_diff = (corridor_bearing - st.heading_rad + math.pi) % (2.0 * math.pi) - math.pi
                st.heading_rad += math.copysign(min(abs(corridor_diff), math.radians(14.0) * dt), corridor_diff)
                st.roll_rad = math.copysign(min(math.radians(22.0), abs(corridor_diff) * 2.0), corridor_diff)

                # Valley Basin Thermal Loitering: UAV remains cruising in the low, cold canyon basin
                # until CHT is fully normalized to baseline nominal temperature (<= 100.0°C)
                # and stabilizes for at least 1.5s before commencing pull-up ascension
                st.basin_loiter_s = getattr(st, 'basin_loiter_s', 0.0)
                if st.cht_c <= 100.0:
                    st.basin_loiter_s += dt
                    st.ai_status = f"BASIN LOITER: NORMALIZING ({st.basin_loiter_s:.1f}s/1.5s)"
                    st.ai_color = (0.0, 0.95, 0.4, 1.0)
                else:
                    st.basin_loiter_s = 0.0
                    st.ai_status = f"CANYON SPRINT: CHT {st.cht_c:.1f}°C ▼"
                    st.ai_color = (0.0, 0.85, 1.0, 1.0)

                # ONLY climb once CHT is fully back to normal (<= 100°C) AND stabilized for 1.5s!
                if st.cht_c <= 100.0 and st.basin_loiter_s >= 1.5:
                    st.dive_phase = "RECLIMB"
                    st.fault_overheat = False
                    st.basin_loiter_s = 0.0
                    st.add_log(f"[THERMAL RECOVERY] CHT fully normalized to {st.cht_c:.1f}°C! Commencing pull-up ascension to 5,800m!", (0.0, 0.95, 0.4, 1.0))
                    st.ai_status = "RE-CLIMB: PULLING UP TO CRUISE"
                    st.ai_color = (0.0, 0.95, 0.4, 1.0)

            elif st.dive_phase == "RECLIMB":
                # 4. Actual steep pull-up ascension out of the canyon!
                target_climb_pitch = math.radians(18.0)  # Actual steep climb attitude!
                st.pitch_rad += (target_climb_pitch - st.pitch_rad) * min(1.0, 3.5 * dt)
                st.throttle_pct = min(95.0, st.throttle_pct + 35.0 * dt) # Full climb power!
                st.roll_rad *= max(0.0, 1.0 - 4.0 * dt)

                # Safe arrival back at high cruise altitude
                if st.pos.z >= st.target_safe_cruise - 60.0:
                    st.dive_phase = "IDLE"
                    st.tactical_dive_active = False
                    st.pitch_rad = 0.0
                    st.throttle_pct = 80.0
                    st.add_log("[SYSTEM] Re-established at high cruise (5,800m AMSL). Sortie resumed.", (0.4, 0.8, 1.0, 1.0))
                    st.ai_status = "NOMINAL TRANSIT"
                    st.ai_color = (0.0, 0.95, 0.4, 1.0)
                    st.mission_phase = "HIGH CRUISE (5,800m)"

    # ── 4. 3D ORIENTATION & TRI-POINT PHYSICAL WING ENVELOPE (14.66m SPAN) ──────
    cos_pit = math.cos(st.pitch_rad)
    sin_pit = math.sin(st.pitch_rad)
    fwd_vel = mathutils.Vector((
        math.sin(st.heading_rad) * cos_pit,
        math.cos(st.heading_rad) * cos_pit,
        sin_pit
    )).normalized()

    # Step vector for this frame
    delta_step = fwd_vel * st.speed_ms * dt
    step_len = delta_step.length
    sweep_dist = step_len + 8.0

    # Build 3D coordinate frame (Fuselage forward, Wing lateral, Vertical normal)
    up_world = mathutils.Vector((0.0, 0.0, 1.0))
    right_base = fwd_vel.cross(up_world).normalized()
    up_base = right_base.cross(fwd_vel).normalized()

    # Apply roll around the flight axis
    rot_roll = mathutils.Matrix.Rotation(st.roll_rad, 3, fwd_vel)
    right_rolled = rot_roll @ right_base
    up_rolled = rot_roll @ up_base

    # Tri-Point Wing Envelope: Fuselage Center, Left Wingtip, Right Wingtip (14.66m total span)
    left_wing_pos = st.pos - right_rolled * WING_SEMI_SPAN
    right_wing_pos = st.pos + right_rolled * WING_SEMI_SPAN

    # ── 5. LOW-OVERHEAD SWEPT COLLISION & WING CLEARANCE SENSING (143 FPS) ───
    # Staggers raycasts across 3 frame slots (at 143 FPS, 3 frames = 21ms motion).
    # Cuts raycasting overhead by 80%, reducing frame time to < 1.5ms for pure 143 FPS!
    st.col_slot = getattr(st, 'col_slot', 0) + 1
    col_slot = st.col_slot % 3

    if col_slot == 0:
        # Fuselage forward sweep & belly ground check
        hit_impact, loc_impact, dist_impact, _ = radar.raycast(st.pos, fwd_vel, sweep_dist)
        st.last_impact = (hit_impact, loc_impact, dist_impact)
        hit_g, loc_g, _, _ = radar.raycast(st.pos + mathutils.Vector((0, 0, 30.0)), mathutils.Vector((0, 0, -1.0)), 200.0)
        if hit_g:
            st.last_ground_z = loc_g.z
            if not hasattr(st, 'last_lw_ground_z'): st.last_lw_ground_z = loc_g.z
            if not hasattr(st, 'last_rw_ground_z'): st.last_rw_ground_z = loc_g.z
    elif col_slot == 1:
        # Left Wingtip forward sweep & downward ground clearance
        if st.agl_m < 300.0 or abs(st.roll_rad) > 0.08:
            hit_lw, loc_lw, dist_lw, _ = radar.raycast(left_wing_pos, fwd_vel, sweep_dist)
            st.last_lw = (hit_lw, loc_lw, dist_lw)
            hit_gw_l, loc_gw_l, _, _ = radar.raycast(left_wing_pos + mathutils.Vector((0, 0, 30.0)), mathutils.Vector((0, 0, -1.0)), 200.0)
            if hit_gw_l:
                st.last_lw_ground_z = loc_gw_l.z
    elif col_slot == 2:
        # Right Wingtip forward sweep & downward ground clearance
        if st.agl_m < 300.0 or abs(st.roll_rad) > 0.08:
            hit_rw, loc_rw, dist_rw, _ = radar.raycast(right_wing_pos, fwd_vel, sweep_dist)
            st.last_rw = (hit_rw, loc_rw, dist_rw)
            hit_gw_r, loc_gw_r, _, _ = radar.raycast(right_wing_pos + mathutils.Vector((0, 0, 30.0)), mathutils.Vector((0, 0, -1.0)), 200.0)
            if hit_gw_r:
                st.last_rw_ground_z = loc_gw_r.z

    # Retrieve cached sensor data
    hit_impact, loc_impact, dist_impact = getattr(st, 'last_impact', (False, None, 0.0))
    hit_lw, loc_lw, dist_lw = getattr(st, 'last_lw', (False, None, 0.0))
    hit_rw, loc_rw, dist_rw = getattr(st, 'last_rw', (False, None, 0.0))

    ground_z = getattr(st, 'last_ground_z', 4608.0)
    lw_ground_z = getattr(st, 'last_lw_ground_z', ground_z)
    rw_ground_z = getattr(st, 'last_rw_ground_z', ground_z)

    st.lw_agl = left_wing_pos.z - lw_ground_z
    st.rw_agl = right_wing_pos.z - rw_ground_z
    st.min_wing_agl = min(st.lw_agl, st.rw_agl)

    # Dynamic wing ground clearance protection (Copilot ON or Tactical Dive Active)
    if (st.copilot_on or st.tactical_dive_active) and st.min_wing_agl < MIN_WING_CLEARANCE_M:
        # Lower wing is dipping dangerously close to canyon rocks during a turn: level wings!
        if st.lw_agl < st.rw_agl:
            st.roll_rad += math.radians(24.0) * dt * 3.5  # Roll right to lift dipped left wing
        else:
            st.roll_rad -= math.radians(24.0) * dt * 3.5  # Roll left to lift dipped right wing

    # Dynamic wing cliff wall avoidance
    if (st.copilot_on or st.tactical_dive_active):
        if hit_lw and dist_lw < sweep_dist + 15.0:
            st.heading_rad += math.radians(14.0) * dt  # Steer right away from left rock face
            st.roll_rad = min(st.roll_rad, math.radians(8.0))
        if hit_rw and dist_rw < sweep_dist + 15.0:
            st.heading_rad -= math.radians(14.0) * dt  # Steer left away from right rock face
            st.roll_rad = max(st.roll_rad, -math.radians(8.0))

    # Collision condition flags
    is_rock_collision = hit_impact and (dist_impact <= sweep_dist)
    is_ground_collision = (st.pos.z + delta_step.z) <= (ground_z + CRASH_AGL_M)
    is_lw_cliff_collision = hit_lw and (dist_lw <= sweep_dist)
    is_rw_cliff_collision = hit_rw and (dist_rw <= sweep_dist)
    is_lw_ground_strike = (left_wing_pos.z + delta_step.z) <= (lw_ground_z + 1.2)
    is_rw_ground_strike = (right_wing_pos.z + delta_step.z) <= (rw_ground_z + 1.2)

    any_collision = (is_rock_collision or is_ground_collision or 
                     is_lw_cliff_collision or is_rw_cliff_collision or 
                     is_lw_ground_strike or is_rw_ground_strike)

    if any_collision:
        if not st.copilot_on:
            # Full manual authority: CATASTROPHIC CFIT / WING STRIKE TERRAIN CRASH!
            if is_lw_cliff_collision:
                st.pos = loc_lw
                impact_type = "LEFT WINGTIP CLIFF STRIKE (14.66m SPAN)"
            elif is_rw_cliff_collision:
                st.pos = loc_rw
                impact_type = "RIGHT WINGTIP CLIFF STRIKE (14.66m SPAN)"
            elif is_lw_ground_strike:
                st.pos = left_wing_pos
                impact_type = "LEFT WING GROUND CARTWHEEL"
            elif is_rw_ground_strike:
                st.pos = right_wing_pos
                impact_type = "RIGHT WING GROUND CARTWHEEL"
            elif is_rock_collision:
                st.pos = loc_impact
                impact_type = "MOUNTAIN ROCK FACE (NOSE IMPACT)"
            else:
                st.pos.z = ground_z + 1.5
                impact_type = "CANYON FLOOR BELLY IMPACT"

            uav.location = st.pos
            _trigger_crash_event(st, uav, impact_type=impact_type)
            return
        elif st.tactical_dive_active:
            max_floor_z = max(ground_z, max(lw_ground_z, rw_ground_z))
            if st.pos.z <= 4300.0:
                # Canyon floor reached: glide smoothly along river bed with wing clearance
                st.pos.z = max(st.pos.z, max_floor_z + MIN_SAFE_AGL_M)
                st.pitch_rad = max(0.0, st.pitch_rad)
                st.roll_rad *= max(0.0, 1.0 - 5.0 * dt)
                st.dive_phase = "LEVEL_SPRINT"
            else:
                # High-altitude terrain obstacle during dive: pitch up safely over ridge!
                st.pos.z = max(st.pos.z, max_floor_z + MIN_SAFE_AGL_M + 10.0)
                st.pitch_rad = max(math.radians(12.0), st.pitch_rad + RECOVERY_PULL_RADS * dt)
        else:
            # Auto-GCAS active in normal manual/cruise flight: prevent impact, enforce emergency pull-up
            st.gcas_active = True
            st.pitch_rad = MAX_PITCH_UP_RAD
            st.roll_rad = 0.0
            st.rpm = 5500.0

    # Step aircraft position forward
    st.pos += delta_step
    uav.location = st.pos

    # Build exact world rotation matrix (True 1:1 MQ-1 Predator 14.66m wingspan, scale 1.0):
    rot_mat = mathutils.Matrix((-right_rolled, -fwd_vel, up_rolled)).transposed()
    uav.matrix_world = mathutils.Matrix.Translation(st.pos) @ rot_mat.to_4x4()

    # ── 6. DYNAMIC THROTTLE RESPONSE ──────────────────────────────────────────
    if st.inp_throttle_up:
        st.throttle_pct = min(100.0, st.throttle_pct + 40.0 * dt)
    elif st.inp_throttle_down:
        st.throttle_pct = max(30.0, st.throttle_pct - 40.0 * dt)

    target_rpm = 3800.0 + (st.throttle_pct / 100.0) * (5800.0 - 3800.0)
    st.rpm += (target_rpm - st.rpm) * min(1.0, 4.0 * dt)

    # Dynamic airspeed based on throttle setting and dive gravity assist (1:1 physical scale)
    target_speed = CRUISE_SPEED_MS + (st.throttle_pct / 100.0 - 0.70) * (SPRINT_SPEED_MS - CRUISE_SPEED_MS) / 0.30
    st.speed_ms += (target_speed - st.speed_ms) * min(1.0, 1.8 * dt)
    # Gravity speed gain/loss during pitch
    st.speed_ms = max(55.0, min(125.0, st.speed_ms - sin_pit * 25.0 * dt))

    # ── 7. ROTAX 912 iS FIRST-PRINCIPLES THERMODYNAMIC TWIN ───────────────────
    st.altitude_m = st.pos.z
    st.altitude_ft = st.altitude_m * 3.28084
    st.heading_deg = (math.degrees(st.heading_rad) + 360.0) % 360.0
    st.airspeed_kias = st.speed_ms * 1.94384

    # Injector fault simulation (Fault 02/03)
    if st.fault_injector:
        st.rpm_jitter = math.sin(time.time() * 22.0) * 180.0
        st.rpm = max(3600.0, min(5800.0, st.rpm + st.rpm_jitter * dt * 5.0))
        st.fuel_flow_lh = 11.2
    else:
        st.fuel_flow_lh = 10.0 + (st.throttle_pct / 100.0) * 16.0

    # 1. Atmospheric ISA lapse rate: cold mountain air
    t_amb = 15.0 - 0.0065 * st.altitude_m
    # 2. Relative air density rho(z) (thin at 5,800m, dense in canyon gorge)
    rho_rel = max(0.35, (1.0 - 0.0065 * st.altitude_m / 288.15) ** 4.256)

    # 3. Engine heat generation: Fault 01 adds abnormal combustion heat
    # Operational Rule: Temperature reduction ONLY occurs once the UAV has ACTUALLY descended below 4,400m into dense air!
    in_dense_canyon = (st.altitude_m < 4400.0)

    if st.fault_overheat:
        if in_dense_canyon:
            extra_heat = 4.0   # FADEC mixture quench active in dense air
        else:
            extra_heat = 22.0  # High altitude: FULL OVERHEAT SURGE!
    else:
        extra_heat = 0.0

    q_in = 22.0 * ((st.rpm / 5200.0) ** 2.2) + extra_heat

    # 4. Ram air convective cooling: dynamic pressure mass flux (rho * v)
    v_factor = max(0.3, (st.speed_ms / CRUISE_SPEED_MS) ** 1.0)
    if in_dense_canyon:
        cool_coeff = 0.75  # High heat extraction in dense canyon gorge air
    elif st.altitude_m < 5000.0:
        cool_coeff = 0.45  # Transition cooling as dive deepens
    else:
        cool_coeff = 0.22  # High cruise thin air — cannot prevent overheat!

    q_cool = cool_coeff * rho_rel * v_factor * (st.cht_c - t_amb)

    # 5. Live Cylinder Head Temperature (CHT) physical integration
    new_cht = max(88.0, min(142.0, st.cht_c + ((q_in - q_cool) / 8.0) * dt))
    st.cht_rate_c_s = (new_cht - st.cht_c) / max(0.0001, dt)
    st.cht_c = new_cht
    st.last_cht_c = st.cht_c

    # 6. Coupled oil pressure: Fault 04 decays oil pressure
    if st.fault_oil_loss:
        st.oil_p_bar = max(1.4, st.oil_p_bar - 0.35 * dt)
    else:
        st.oil_p_bar = max(3.5, min(5.0, 4.20 - 0.015 * (st.cht_c - 104.0)))

    # 7. Dynamic FADEC diagnostics and notifications
    if st.fault_overheat:
        if st.cht_c > 124.0:
            st.ai_status = "CRITICAL: CHT THERMAL RUNAWAY"
            st.ai_color = (1.0, 0.15, 0.15, 1.0)
        else:
            st.ai_status = "FADEC: CYL #2 CHT OVERHEAT"
            st.ai_color = (1.0, 0.45, 0.0, 1.0)
    elif st.fault_oil_loss:
        if st.oil_p_bar < 2.0:
            st.ai_status = "CRITICAL: OIL PRESSURE LOSS"
            st.ai_color = (1.0, 0.15, 0.15, 1.0)
        else:
            st.ai_status = "FADEC: OIL PRESSURE LOSS"
            st.ai_color = (1.0, 0.55, 0.0, 1.0)
    elif st.fault_injector:
        st.ai_status = "FADEC: INJECTOR #1 CLOG (LANE B)"
        st.ai_color = (1.0, 0.65, 0.0, 1.0)
    elif st.cht_c > 120.0 and not getattr(st, 'warn_cht_high', False):
        st.warn_cht_high = True
        st.add_log(f"[FADEC ALERT] CHT elevated ({st.cht_c:.1f}°C)! Thin air cooling limit. Dive or throttle down.", (1.0, 0.3, 0.3, 1.0))
    elif st.cht_c < 106.0 and getattr(st, 'warn_cht_high', False):
        st.warn_cht_high = False
        st.add_log(f"[THERMAL] Convective cooling nominal! CHT normalized to {st.cht_c:.1f}°C.", (0.0, 0.95, 0.4, 1.0))

    if st.altitude_m < 4200.0:
        st.mission_phase = "CANYON GORGE SPRINT (3,850m)"
    else:
        st.mission_phase = "HIGH CRUISE (5,800m)"


def update_chase_camera(st: FlightState):
    """Position Maverick Hero Chase Camera behind the pusher propeller."""
    cam = bpy.data.objects.get(CAM_NAME)
    if cam is None:
        return

    # Horizontal tail direction (opposite of heading)
    tail_dir = mathutils.Vector((-math.sin(st.heading_rad), -math.cos(st.heading_rad), 0.0)).normalized()
    up_vec = mathutils.Vector((0.0, 0.0, 1.0))

    # Ideal camera position: behind pusher prop and elevated
    ideal_cam_pos = st.pos + tail_dir * CAM_DIST_BEHIND + up_vec * CAM_HEIGHT_ABOVE

    # Smooth camera inertia
    if st.cam_world_pos is None:
        st.cam_world_pos = ideal_cam_pos.copy()
    else:
        st.cam_world_pos = st.cam_world_pos.lerp(ideal_cam_pos, CAM_LERP_FACTOR)

    cam.location = st.cam_world_pos

    # Look target: ahead of the aircraft nose along flight path
    fwd_horiz = -tail_dir
    look_target = st.pos + fwd_horiz * CAM_LOOK_AHEAD - up_vec * 0.5
    cam_dir = (look_target - cam.location).normalized()
    if cam_dir.length > 0.01:
        cam_rot = cam_dir.to_track_quat('-Z', 'Y')
        cam.rotation_euler = cam_rot.to_euler()


def _trigger_crash_event(st: FlightState, uav, impact_type="TERRAIN ROCK FACE"):
    """Halt simulation and capture crash telemetry card."""
    if st.is_crashed:
        return
    st.is_crashed = True
    st.crash_info = {
        "airspeed": f"{st.airspeed_kias:.1f} KIAS ({st.speed_ms:.0f} m/s)",
        "altitude": f"{st.altitude_ft:.0f} FT ({st.altitude_m:.0f}m AMSL)",
        "coordinates": f"X: {st.pos.x:.1f}  Y: {st.pos.y:.1f}  Z: {st.pos.z:.1f}",
        "heading": f"{st.heading_deg:.0f}°",
        "pitch": f"{math.degrees(st.pitch_rad):+.1f}°",
        "bank": f"{math.degrees(st.roll_rad):+.1f}°",
        "impact_type": impact_type,
        "engine_cht": f"{st.cht_c:.1f}°C",
        "engine_oil": f"{st.oil_p_bar:.2f} BAR",
        "engine_rpm": f"{st.rpm:.0f} RPM",
        "cause": "Auto-GCAS Override DISABLED. Controlled Flight Into Terrain (CFIT).",
    }
    st.add_log(f"[CRASH] {impact_type} IMPACT! Controlled Flight Into Terrain.", (1.0, 0.1, 0.1, 1.0))

    if mission_recorder is not None:
        try:
            mission_recorder.log_crash(st, impact_type)
        except Exception:
            pass  # a debrief entry is never worth interrupting the crash HUD for


