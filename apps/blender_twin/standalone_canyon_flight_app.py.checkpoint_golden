        self.text(f"AGL: {st.agl_m:.0f}m", rx + 10, ry + 26, 11, agl_col)

        # ─── CENTER CROSSHAIRS & PITCH LADDER ─────────────────────────────────
        self.rect(cx - 30, cy, 22, 2, (0.0, 0.9, 1.0, 0.85))
        self.rect(cx + 8, cy, 22, 2, (0.0, 0.9, 1.0, 0.85))
        self.rect(cx - 1, cy - 10, 2, 20, (0.0, 0.9, 1.0, 0.85))

        # ─── RADAR / GCAS MARGIN STRIP ────────────────────────────────────────
        rw = 340
        rx2 = cx - rw / 2.0
        ry2 = cy - 125
        rcol = (1.0, 0.2, 0.2, 0.9) if st.tti_s < GCAS_RECOVER_TTI_S else \
               ((1.0, 0.7, 0.0, 0.85) if st.tti_s < GCAS_WARN_TTI_S else (0.0, 0.85, 0.6, 0.65))

        self.rect(rx2, ry2, rw, 44, (0.02, 0.05, 0.10, 0.85))
