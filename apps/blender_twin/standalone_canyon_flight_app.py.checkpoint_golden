        if dedupe and self._logs and self._logs[-1][0] == text and (now - self.last_log_time) < LOG_COOLDOWN_S:
            return
        self._logs.append((text, color))
        self.last_log_time = now
        if len(self._logs) > 6:
            self._logs.pop(0)

    @property
    def logs(self):
        return self._logs


