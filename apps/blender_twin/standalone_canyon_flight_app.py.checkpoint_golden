class OT_CanyonTacticalFlightSim(bpy.types.Operator):
    bl_idname  = "view3d.canyon_tactical_flight_sim"
    bl_label   = "Top Gun Maverick Tactical Canyon Simulator"
    _timer     = None
    _handle_2d = None

    def modal(self, context, event):
        st = flight_state

        if event.type == 'ESC':
            self.cancel(context)
            return {'CANCELLED'}

        pressed = event.value == 'PRESS'
        released = event.value == 'RELEASE'

        # Consume all mouse movement/clicks so moving the cursor never moves the camera or viewport
        if event.type in {'MOUSEMOVE', 'INBETWEEN_MOUSEMOVE', 'MIDDLEMOUSE', 'WHEELUPMOUSE', 'WHEELDOWNMOUSE',
                          'TRACKPADPAN', 'TRACKPADZOOM', 'LEFTMOUSE', 'RIGHTMOUSE'}:
            return {'RUNNING_MODAL'}

        # Stick inputs (held keys)
        if event.type in {'W', 'UP_ARROW'}:
            st.inp_pitch_up = pressed
            return {'RUNNING_MODAL'}
        elif event.type in {'S', 'DOWN_ARROW'}:
            st.inp_pitch_down = pressed
            return {'RUNNING_MODAL'}
        elif event.type in {'A', 'LEFT_ARROW'}:
            st.inp_turn_left = pressed
            return {'RUNNING_MODAL'}
        elif event.type in {'D', 'RIGHT_ARROW'}:
            st.inp_turn_right = pressed
            return {'RUNNING_MODAL'}

        # Continuous Throttle Controls
        if event.type in {'E', 'PAGE_UP'}:
            st.inp_throttle_up = pressed
            return {'RUNNING_MODAL'}
        elif event.type in {'Q', 'PAGE_DOWN'}:
            st.inp_throttle_down = pressed
            return {'RUNNING_MODAL'}

        # Space: Pause
        elif event.type == 'SPACE' and pressed:
            st.is_paused = not st.is_paused
            st.add_log(f"[SIM] Simulation {'PAUSED' if st.is_paused else 'RESUMED'}.", (0.9, 0.9, 0.0, 1.0))
            return {'RUNNING_MODAL'}

        # Power Presets 1, 2, 3: Direct Engine Throttle & Thermal Setting
        elif event.type in {'ONE', 'NUMPAD_1'} and pressed:
            st.throttle_pct = 50.0
            st.add_log("[FADEC] Power Preset 1: ECO CRUISE (50% / 4,800 RPM). Rapid cooldown.", (0.0, 0.95, 0.4, 1.0))
            return {'RUNNING_MODAL'}

        elif event.type in {'TWO', 'NUMPAD_2'} and pressed:
            st.throttle_pct = 80.0
            st.add_log("[FADEC] Power Preset 2: COMBAT SPRINT (80% / 5,400 RPM). Balanced thermal load.", (0.4, 0.8, 1.0, 1.0))
            return {'RUNNING_MODAL'}

        elif event.type in {'THREE', 'NUMPAD_3'} and pressed:
            st.throttle_pct = 100.0
            st.add_log("[FADEC] Power Preset 3: MAX CONTINUOUS (100% / 5,800 RPM). High thermal output.", (1.0, 0.6, 0.0, 1.0))
            return {'RUNNING_MODAL'}

        # Hotkey P / C: Toggle Copilot Mode
        elif event.type in {'P', 'C'} and pressed:
            st.copilot_on = not st.copilot_on
            if st.copilot_on:
                st.add_log("[COPILOT] Auto-GCAS ARMED. Terrain safety override active.", (0.0, 0.95, 0.4, 1.0))
            else:
                st.add_log("[COPILOT] WARNING: Full manual authority. Auto-GCAS disabled.", (1.0, 0.3, 0.3, 1.0))
            return {'RUNNING_MODAL'}

        # Hotkey R: Reset
        elif event.type == 'R' and pressed:
            self._reset_sim()
            return {'RUNNING_MODAL'}

        # 120 FPS Continuous Physics Timer Tick
        if event.type == 'TIMER':
            update_simulation(st)
            update_chase_camera(st)
            # Continuous redraw across all 3D viewports
            for win in context.window_manager.windows:
                for area in win.screen.areas:
                    if area.type == 'VIEW_3D':
                        area.tag_redraw()
            return {'RUNNING_MODAL'}

        return {'RUNNING_MODAL'}

    def _reset_sim(self):
        st = flight_state
        uav = bpy.data.objects.get(UAV_NAME)
        cam = bpy.data.objects.get(CAM_NAME)
        fp = bpy.data.objects.get(PATH_NAME)

        # Hide corridor curve object (removes 3D path line)
        if fp:
            fp.hide_viewport = True
            fp.hide_render = True
            try:
                fp.hide_set(True)
            except Exception:
                pass

        # Clear keyframe animation and constraints (removes Damped Track dotted line)
        if cam:
            cam.constraints.clear()
            if cam.animation_data:
                cam.animation_data_clear()

        if uav and uav.animation_data:
            uav.animation_data_clear()

        st.pos = INGRESS_POS.copy()
        st.heading_rad = math.radians(NOMINAL_HEADING_DEG)
        st.pitch_rad = 0.0
        st.roll_rad = 0.0
        st.speed_ms = CRUISE_SPEED_MS
        st.is_crashed = False
        st.crash_info = {}
        st.gcas_active = False
        st.gcas_clearing = False
        st.warning_active = False
        st.throttle_pct = 80.0
        st.inp_throttle_up = False
        st.inp_throttle_down = False
        st.rpm = 5200.0
        st.cht_c = 104.2
        st.oil_p_bar = 4.20
        st.warn_cht_high = False
        st.cam_world_pos = None

        if uav:
            uav.location = st.pos
            # Reset orientation
            update_simulation(st)

        st.add_log("[SYSTEM] Reset to Ladakh canyon ingress (5,800m AMSL).", (0.4, 0.8, 1.0, 1.0))

    def invoke(self, context, event):
        if context.area.type != 'VIEW_3D':
            return {'CANCELLED'}

        self._handle_2d = bpy.types.SpaceView3D.draw_handler_add(
            _draw_callback, (self, context), 'WINDOW', 'POST_PIXEL'
        )
        wm = context.window_manager
        # Pure 143 FPS Event Timer (1.0 / 143.0 s = 6.99 ms)
        self._timer = wm.event_timer_add(1.0 / 143.0, window=context.window)
        wm.modal_handler_add(self)

        self._reset_sim()
        print(">>> Top Gun Maverick Canyon Simulator Active (Pure 143 FPS Native Physics) <<<")
        return {'RUNNING_MODAL'}

    def cancel(self, context):
        if self._timer:
            context.window_manager.event_timer_remove(self._timer)
        if self._handle_2d:
            bpy.types.SpaceView3D.draw_handler_remove(self._handle_2d, 'WINDOW')
        for win in context.window_manager.windows:
            for area in win.screen.areas:
                if area.type == 'VIEW_3D':
                    area.tag_redraw()
        print(">>> Canyon Flight Simulator Closed. <<<")


# ─────────────────────────────────────────────────────────────────────────────
# 6. VIEWPORT & WORKSPACE INITIALIZATION
# ─────────────────────────────────────────────────────────────────────────────
def configure_clean_viewport():
    scene = bpy.context.scene

    # Stop any animation playback
    if bpy.context.screen and bpy.context.screen.is_animation_playing:
        bpy.ops.screen.animation_cancel(restore_frame=False)

    cam = bpy.data.objects.get(CAM_NAME)
    if cam:
        cam.constraints.clear()   # remove Damped Track dotted line
        scene.camera = cam

    fp = bpy.data.objects.get(PATH_NAME)
    if fp:
        fp.hide_viewport = True
        fp.hide_render = True
        try:
            fp.hide_set(True)
        except Exception:
            pass

    # Set borderless rendered shading & disable relationship lines
    for screen in bpy.data.screens:
        for area in screen.areas:
            if area.type == 'VIEW_3D':
                for space in area.spaces:
                    if space.type == 'VIEW_3D':
                        space.lock_camera = False
                        space.lock_cursor = True
                        space.region_3d.view_perspective = 'CAMERA'
                        space.shading.type = 'RENDERED'
                        space.shading.use_scene_lights = True
                        space.shading.use_scene_world = True
                        space.overlay.show_overlays = False
                        space.overlay.show_relationship_lines = False
                        space.show_gizmo = False
                        space.show_region_toolbar = False
                        space.show_region_ui = False
                        space.show_region_header = False

    # Maximize and start simulation operator
    for window in bpy.context.window_manager.windows:
        for area in window.screen.areas:
            if area.type == 'VIEW_3D':
                for region in area.regions:
                    if region.type == 'WINDOW':
                        try:
                            with bpy.context.temp_override(window=window, area=area, region=region):
                                bpy.ops.screen.screen_full_area(use_hide_panels=True)
                                bpy.ops.view3d.canyon_tactical_flight_sim('INVOKE_DEFAULT')
                        except Exception as e:
                            print(f"[NOTE] Viewport initialized: {e}")
                        return


