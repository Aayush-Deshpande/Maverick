# ─────────────────────────────────────────────────────────────────────────────
# 1. DIRECT DEM TERRAIN RADAR (Zero Self-Intersection)
# ─────────────────────────────────────────────────────────────────────────────
class TacticalTerrainRadar:
    def __init__(self):
        self._dem = None
        self._inv_mat = None
        self._inv_rot = None

    def _ensure_dem(self):
        if self._dem is None:
            self._dem = bpy.data.objects.get(DEM_NAME)
            if self._dem:
                self._inv_mat = self._dem.matrix_world.inverted()
                self._inv_rot = self._inv_mat.to_3x3()
        return self._dem is not None

    def raycast(self, world_origin: mathutils.Vector, world_direction: mathutils.Vector, max_dist: float = 10000.0):
        """Direct raycast against the Copernicus DEM mesh. Immune to UAV self-hits."""
        if not self._ensure_dem():
            return False, None, float('inf'), None

        loc_origin = self._inv_mat @ world_origin
        loc_dir = (self._inv_rot @ world_direction).normalized()
        hit, loc, norm, _ = self._dem.ray_cast(loc_origin, loc_dir, distance=max_dist)
        if hit:
            hit_world = self._dem.matrix_world @ loc
            dist = (hit_world - world_origin).length
            norm_world = (self._dem.matrix_world.to_3x3() @ norm).normalized()
            return True, hit_world, dist, norm_world
        return False, None, float('inf'), None


