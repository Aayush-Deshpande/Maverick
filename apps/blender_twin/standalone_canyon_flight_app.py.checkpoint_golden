# 4. 2D GPU HUD OVERLAY (60-120 FPS NATIVE)
# ─────────────────────────────────────────────────────────────────────────────
class TacticalHUDDrawer:
    def __init__(self):
        self.font_id = 0
        self._shader = None

    def _sh(self):
        if self._shader is None:
            try:
                self._shader = gpu.shader.from_builtin('UNIFORM_COLOR')
            except Exception:
                self._shader = gpu.shader.from_builtin('2D_UNIFORM_COLOR')
        return self._shader

    def rect(self, x, y, w, h, color):
        sh = self._sh()
        gpu.state.blend_set('ALPHA')
        verts = [(x, y), (x + w, y), (x + w, y + h), (x, y + h)]
        batch = batch_for_shader(sh, 'TRIS', {"pos": verts}, indices=[(0, 1, 2), (0, 2, 3)])
        sh.bind()
        sh.uniform_float("color", color)
        batch.draw(sh)
        gpu.state.blend_set('NONE')

    def outline(self, x, y, w, h, color):
        sh = self._sh()
        gpu.state.blend_set('ALPHA')
        verts = [(x, y), (x + w, y), (x + w, y + h), (x, y + h)]
        batch = batch_for_shader(sh, 'LINE_LOOP', {"pos": verts})
        sh.bind()
        sh.uniform_float("color", color)
        batch.draw(sh)
        gpu.state.blend_set('NONE')

    def text(self, s, x, y, size=13, color=(0.0, 0.9, 1.0, 1.0)):
        blf.position(self.font_id, x, y, 0)
        blf.size(self.font_id, size)
        blf.color(self.font_id, *color)
        blf.draw(self.font_id, str(s))

    def render(self, W, H, st: FlightState):
        # ─── CRASH SCREEN (Full Overlay) ──────────────────────────────────────
        if st.is_crashed:
            self._render_crash_screen(W, H, st)
            return

        cx, cy = W / 2.0, H / 2.0

        # ─── TOP HEADER BAR ───────────────────────────────────────────────────
        hh = 46
        hy = H - hh - 12
        self.rect(20, hy, W - 40, hh, (0.02, 0.05, 0.10, 0.92))
        self.outline(20, hy, W - 40, hh, (0.0, 0.85, 1.0, 0.50))
        self.text("TOP GUN: MAVERICK // LADAKH CANYON UAV DIGITAL TWIN", 35, hy + 25, 15, (0.0, 0.9, 1.0, 1.0))

        copilot_str = "COPILOT: ON (AUTO-GCAS ARMED)" if st.copilot_on else "COPILOT: OFF [MANUAL RISK]"
        copilot_col = (0.0, 0.95, 0.4, 1.0) if st.copilot_on else (1.0, 0.25, 0.25, 1.0)
        self.text(f"HDG: {st.heading_deg:05.1f}°  |  {copilot_str}  |  AGL: {st.agl_m:.0f}m  |  {st.mission_phase}",
                  35, hy + 9, 11, (0.7, 0.85, 1.0, 0.85))

        # Status badge top-right
        bw = 310
        bx = W - bw - 30
        self.rect(bx, hy + 7, bw, 32, (0.0, 0.10, 0.20, 0.85))
        self.outline(bx, hy + 7, bw, 32, st.ai_color)
        self.text(st.ai_status, bx + 14, hy + 18, 11, st.ai_color)

        # ─── AIRSPEED (Left Tape) ─────────────────────────────────────────────
        ax, ay = cx - 260, cy - 80
        self.rect(ax, ay, 95, 160, (0.02, 0.05, 0.10, 0.80))
        self.outline(ax, ay, 95, 160, (0.0, 0.85, 1.0, 0.35))
        self.text("AIRSPEED", ax + 10, ay + 140, 10, (0.6, 0.8, 1.0, 0.75))
        self.text(f"{st.airspeed_kias:.0f}", ax + 10, ay + 92, 24, (0.0, 0.95, 1.0, 1.0))
        self.text("KIAS", ax + 10, ay + 70, 11, (0.5, 0.75, 0.95, 0.85))
        self.text(f"{st.speed_ms:.0f} m/s", ax + 10, ay + 48, 10, (0.0, 0.85, 0.4, 1.0))

        # ─── ALTITUDE (Right Tape) ────────────────────────────────────────────
        rx, ry = cx + 165, cy - 80
        self.rect(rx, ry, 140, 160, (0.02, 0.05, 0.10, 0.80))
        self.outline(rx, ry, 140, 160, (0.0, 0.85, 1.0, 0.35))
        self.text("ALTITUDE", rx + 10, ry + 140, 10, (0.6, 0.8, 1.0, 0.75))
        self.text(f"{st.altitude_ft:.0f}", rx + 10, ry + 92, 22, (0.0, 0.95, 1.0, 1.0))
