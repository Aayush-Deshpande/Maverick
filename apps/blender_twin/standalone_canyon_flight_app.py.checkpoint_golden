        fwd_str = f"{st.fwd_dist_m:.0f}m" if st.fwd_dist_m < 5000.0 else "CLEAR"
        tti_str = f"{st.tti_s:.1f}s" if st.tti_s < 90.0 else ">90s"
        self.text(f"RADAR FWD: {fwd_str}", rx2 + 14, ry2 + 25, 11, rcol)
        self.text(f"TTI: {tti_str}", rx2 + 190, ry2 + 25, 11, rcol)
        self.text(f"LATERAL: L {st.left_dist_m:.0f}m | R {st.right_dist_m:.0f}m   MARGIN: {st.margin_dist_m:.0f}m",
                  rx2 + 14, ry2 + 8, 10, (0.6, 0.75, 0.9, 0.8))

        # ─── PROPULSION TELEMETRY (Left Panel) ────────────────────────────────
        lw, lh = 280, 210
        lx, ly = 20, 75
        self.rect(lx, ly, lw, lh, (0.02, 0.05, 0.10, 0.90))
        self.outline(lx, ly, lw, lh, (0.0, 0.85, 1.0, 0.45))
        self.text("ROTAX 912 iS PROPULSION TWIN", lx + 14, ly + lh - 22, 12, (0.0, 0.9, 1.0, 1.0))

        cht_col = (1.0, 0.2, 0.2, 1.0) if st.cht_c > 120.0 else \
                  ((1.0, 0.7, 0.0, 1.0) if st.cht_c > 110.0 else (0.0, 0.95, 0.4, 1.0))
        gauges = [
            ("ENGINE SPEED",  f"{st.rpm:.0f} RPM",       min(1.0, st.rpm / 5800.0),    (0.0, 0.85, 1.0, 1.0)),
            ("CYLINDER HEAD", f"{st.cht_c:.1f} °C",      min(1.0, st.cht_c / 140.0),   cht_col),
            ("OIL PRESSURE",  f"{st.oil_p_bar:.2f} BAR", min(1.0, st.oil_p_bar / 6.0), (0.0, 0.85, 1.0, 1.0)),
            ("AIRSPEED",      f"{st.airspeed_kias:.0f} KIAS", min(1.0, st.airspeed_kias / 180.0), (0.0, 0.85, 1.0, 1.0)),
        ]
        gy = ly + lh - 50
        for label, val, norm, col in gauges:
            self.text(label, lx + 14, gy + 8, 10, (0.6, 0.75, 0.9, 0.8))
            self.text(val, lx + lw - 95, gy + 8, 11, col)
            self.rect(lx + 14, gy, lw - 28, 4, (0.1, 0.15, 0.25, 0.8))
            self.rect(lx + 14, gy, (lw - 28) * norm, 4, col)
            gy -= 38

        # ─── DECISION LOG (Right Panel) ───────────────────────────────────────
        rpw, rph = 380, 210
        rpx, rpy = W - rpw - 20, 75
        self.rect(rpx, rpy, rpw, rph, (0.02, 0.05, 0.10, 0.90))
        self.outline(rpx, rpy, rpw, rph, st.ai_color)
        self.text("AI COPILOT & AUTO-GCAS DECISION LOG", rpx + 14, rpy + rph - 22, 12, st.ai_color)

        log_y = rpy + rph - 50
        for entry, col in reversed(st.logs[-5:]):
            self.text(entry, rpx + 14, log_y, 10, col)
            log_y -= 26

        # ─── BOTTOM CONTROLS FOOTER ───────────────────────────────────────────
        self.rect(20, 15, W - 40, 32, (0.02, 0.05, 0.10, 0.90))
        self.outline(20, 15, W - 40, 32, (0.0, 0.85, 1.0, 0.35))
        self.text("[W/S] Pitch  |  [A/D] Turn  |  [Q/E] Throttle RPM  |  [1/2/3] Power Presets  |  [P] Copilot  |  [SPACE] Pause  |  [R] Reset  |  [ESC] Exit",
                  30, 24, 11, (0.85, 0.95, 1.0, 0.90))

    def _render_crash_screen(self, W, H, st: FlightState):
        """High-visibility center-screen Crash Card HUD (Copilot OFF)."""
