# ─────────────────────────────────────────────────────────────────────────────
# 3. PHYSICS, GUIDANCE & COLLISION AVOIDANCE ENGINE
# ─────────────────────────────────────────────────────────────────────────────
def update_simulation(st: FlightState):
    """Main physics and guidance tick (runs at pure 143 FPS)."""
    now = time.perf_counter()
    dt = now - st.last_tick_wall
    dt = max(0.001, min(dt, 0.025))   # clamp 1ms … 25ms
    st.last_tick_wall = now

    if st.is_paused or st.is_crashed:
        return

    uav = bpy.data.objects.get(UAV_NAME)
    if uav is None:
        return

    # ── 1. SENSING: Multi-Beam Terrain Radar Probing ───────────────────────────
    # Nominal horizontal forward vector from current heading
    cos_hdg = math.cos(st.heading_rad)
    sin_hdg = math.sin(st.heading_rad)
    # Heading 0 deg = North (+Y). Heading 90 deg = East (+X).
    fwd_horiz = mathutils.Vector((math.sin(st.heading_rad), math.cos(st.heading_rad), 0.0)).normalized()

    # Full 3D forward vector including pitch
    cos_pit = math.cos(st.pitch_rad)
    sin_pit = math.sin(st.pitch_rad)
    fwd_3d = mathutils.Vector((
        fwd_horiz.x * cos_pit,
        fwd_horiz.y * cos_pit,
        sin_pit
    )).normalized()

    # Lateral vectors
    right_horiz = mathutils.Vector((fwd_horiz.y, -fwd_horiz.x, 0.0)).normalized()
    left_horiz = -right_horiz

    # ── 1. SENSING: Low-Overhead 143 FPS Radar Probing ────────────────────────
    st.tick_count = getattr(st, 'tick_count', 0) + 1
    probe_origin = st.pos + mathutils.Vector((0.0, 0.0, 2.0))

    # Stagger raycasts across 12 slots so 67% of frames have ZERO raycasts (0.0 ms)
    # On non-probing frames, ground altitude is computed analytically from last_ground_z
    slot = st.tick_count % 12
    if slot == 0:
        # Downward AGL probe (~12 Hz)
        hit_dn, loc_dn, agl, _ = radar.raycast(probe_origin, mathutils.Vector((0.0, 0.0, -1.0)), 8000.0)
        if hit_dn:
            st.last_ground_z = loc_dn.z
            st.agl_m = agl
    elif slot == 6:
        # Forward center obstacle probe (~12 Hz)
        hit_fwd, _, dist_fwd, _ = radar.raycast(probe_origin, fwd_3d, MAX_RADAR_DIST)
        st.fwd_dist_m = dist_fwd if hit_fwd else MAX_RADAR_DIST
    elif slot == 3:
        # Forward-down pitch-warning probe (~12 Hz)
        fwd_dn = (fwd_horiz * 0.95 + mathutils.Vector((0.0, 0.0, -0.31))).normalized()
        hit_fd, _, dist_fd, _ = radar.raycast(probe_origin, fwd_dn, 3500.0)
        st.dist_fd_m = dist_fd if hit_fd else 3500.0
    elif slot == 9:
        # Lateral wall probes (~12 Hz)
        hit_l, _, dist_l, _ = radar.raycast(probe_origin, (fwd_horiz * 0.7 + left_horiz * 0.7).normalized(), 4000.0)
        hit_r, _, dist_r, _ = radar.raycast(probe_origin, (fwd_horiz * 0.7 + right_horiz * 0.7).normalized(), 4000.0)
        if hit_l: st.left_dist_m = dist_l
        if hit_r: st.right_dist_m = dist_r

    # Analytical real-time AGL on all interim frames (continuous 143 Hz tape updates)
    if hasattr(st, 'last_ground_z'):
        st.agl_m = max(5.0, st.pos.z - st.last_ground_z)

    dist_fd = getattr(st, 'dist_fd_m', 3500.0)

    # Dynamic Time-To-Impact (TTI) and Stopping Margin
    closure_speed = max(10.0, st.speed_ms * cos_pit)
    if st.pitch_rad < -math.radians(3.0):
        st.tti_s = min(st.fwd_dist_m, dist_fd) / closure_speed
    else:
        st.tti_s = st.fwd_dist_m / closure_speed
    st.margin_dist_m = (st.speed_ms ** 2) / (2.0 * 24.5)   # stopping distance margin

    # ── 2. AUTO-GCAS SAFETY GATE ──────────────────────────────────────────────
    if st.copilot_on:
        # Check if aircraft breached safe margin
        is_critical = (st.tti_s <= GCAS_RECOVER_TTI_S) or (st.agl_m <= MIN_SAFE_AGL_M)

        if is_critical or st.gcas_clearing:
            st.gcas_active = True
            # Emergency 2.5G pull-up override:
            target_pitch = MAX_PITCH_UP_RAD
            st.pitch_rad = min(target_pitch, st.pitch_rad + RECOVERY_PULL_RADS * dt)
            st.roll_rad *= max(0.0, 1.0 - 5.0 * dt)   # wings level immediately
            st.rpm = min(5500.0, st.rpm + 800.0 * dt) # spool full throttle

            # Lateral escape bias: steer towards clearer valley side
            if st.left_dist_m > st.right_dist_m + 50.0:
                st.heading_rad -= math.radians(15.0) * dt   # bank left away from right cliff
                st.roll_rad = max(-math.radians(18.0), st.roll_rad - 1.5 * dt)
            elif st.right_dist_m > st.left_dist_m + 50.0:
                st.heading_rad += math.radians(15.0) * dt   # bank right away from left cliff
                st.roll_rad = min(math.radians(18.0), st.roll_rad + 1.5 * dt)

            if is_critical:
                st.gcas_clearing = True
                st.add_log(f"[AUTO-GCAS] 2.5G PULL-UP! Obstacle {st.fwd_dist_m:.0f}m, TTI {st.tti_s:.1f}s!", (1.0, 0.2, 0.2, 1.0))
                st.ai_status = "AUTO-GCAS: EMERGENCY PULL-UP"
                st.ai_color = (1.0, 0.2, 0.2, 1.0)
            elif st.agl_m > MIN_SAFE_AGL_M + 50.0 and st.tti_s > GCAS_WARN_TTI_S:
                # Terrain cleared safely: hand control back
                st.gcas_active = False
                st.gcas_clearing = False
                st.add_log("[COPILOT] Terrain cleared. Resuming operator authority.", (0.0, 0.95, 0.4, 1.0))
                st.ai_status = "NOMINAL TRANSIT"
                st.ai_color = (0.0, 0.95, 0.4, 1.0)

        elif st.tti_s <= GCAS_WARN_TTI_S or st.agl_m <= MIN_SAFE_AGL_M + 80.0:
            # Amber warning zone: advisory alert, pilot retains authority
            st.gcas_active = False
            st.warning_active = True
            st.add_log(f"[WARNING] Terrain proximity ahead: {st.fwd_dist_m:.0f}m (TTI {st.tti_s:.1f}s).", (1.0, 0.7, 0.0, 1.0))
            st.ai_status = "WARNING: TERRAIN PROXIMITY"
            st.ai_color = (1.0, 0.7, 0.0, 1.0)

        else:
            # Green / Nominal regime
            st.gcas_active = False
            st.gcas_clearing = False
            st.warning_active = False
            if st.ai_status.startswith("WARNING") or st.ai_status.startswith("AUTO-GCAS"):
                st.ai_status = "NOMINAL TRANSIT"
                st.ai_color = (0.0, 0.95, 0.4, 1.0)

    else:
        # Copilot OFF — Manual mode. Check for crash collision.
        st.gcas_active = False
        if st.fwd_dist_m <= CRASH_DIST_M or st.agl_m <= CRASH_AGL_M:
            _trigger_crash_event(st, uav)
            return

    # ── 3. PILOT INPUT & DYNAMIC POTENTIAL FIELD (APF) GUIDANCE ───────────────
    if not st.gcas_active:
        user_steering = False

        # Pitch control
        if st.inp_pitch_up:
            st.pitch_rad = min(MAX_PITCH_UP_RAD, st.pitch_rad + PITCH_RATE_RADS * dt)
            user_steering = True
        elif st.inp_pitch_down:
            st.pitch_rad = max(-MAX_PITCH_DOWN_RAD, st.pitch_rad - PITCH_RATE_RADS * dt)
            user_steering = True

        # Roll & Yaw turn control (coordinated turn)
        if st.inp_turn_left:
            st.heading_rad -= TURN_RATE_RADS * dt
            st.roll_rad = max(-MAX_BANK_RAD, st.roll_rad - 2.8 * dt)
            user_steering = True
        elif st.inp_turn_right:
            st.heading_rad += TURN_RATE_RADS * dt
            st.roll_rad = min(MAX_BANK_RAD, st.roll_rad + 2.8 * dt)
            user_steering = True
        else:
            # Wings level recovery
            st.roll_rad *= max(0.0, 1.0 - 3.5 * dt)

        # Autonomous APF corridor centering when pilot is not actively turning
        if not user_steering:
            # Canyon wall repulsion:
            wall_repulsion = 0.0
            if st.left_dist_m < 250.0:
                wall_repulsion += (250.0 - st.left_dist_m) / 250.0 * 0.6
            if st.right_dist_m < 250.0:
                wall_repulsion -= (250.0 - st.right_dist_m) / 250.0 * 0.6
            
            # Apply gentle centering yaw
            st.heading_rad += wall_repulsion * TURN_RATE_RADS * dt * 0.5
            st.roll_rad += wall_repulsion * MAX_BANK_RAD * dt * 0.8
            
            # Gentle pitch trim to follow nominal canyon descent/cruise
            if not st.inp_pitch_up and not st.inp_pitch_down:
                st.pitch_rad *= max(0.0, 1.0 - 1.5 * dt)

    # ── 4. KINEMATIC INTEGRATION & POSITION UPDATE ────────────────────────────
    cos_pit = math.cos(st.pitch_rad)
    sin_pit = math.sin(st.pitch_rad)
    fwd_vel = mathutils.Vector((
        math.sin(st.heading_rad) * cos_pit,
        math.cos(st.heading_rad) * cos_pit,
        sin_pit
    )).normalized()

    # Step aircraft position
    st.pos += fwd_vel * st.speed_ms * dt
    uav.location = st.pos

    # ── 5. TRUE 3D ORIENTATION MATRIX (NOSE FORWARD, ZERO BACKWARDS FLYING) ────
    # In the imported 3D model:
    #   Local -Y is the NOSE (points forward along fwd_vel)
    #   Local +Y is the TAIL / PROPELLER (points backward along -fwd_vel)
    #   Local -X is the RIGHT WING (points right along right_rolled)
    #   Local +X is the LEFT WING (points left along -right_rolled)
    #   Local +Z is UP
    up_world = mathutils.Vector((0.0, 0.0, 1.0))
    right_base = fwd_vel.cross(up_world).normalized()
    up_base = right_base.cross(fwd_vel).normalized()

    # Apply roll around the flight axis
    rot_roll = mathutils.Matrix.Rotation(st.roll_rad, 3, fwd_vel)
    right_rolled = rot_roll @ right_base
    up_rolled = rot_roll @ up_base

    # Build exact world rotation matrix:
    # Col 0: local +X (left wing)  = -right_rolled
    # Col 1: local +Y (tail)       = -fwd_vel
    # Col 2: local +Z (up)         = +up_rolled
    rot_mat = mathutils.Matrix((-right_rolled, -fwd_vel, up_rolled)).transposed()
    uav.matrix_world = mathutils.Matrix.Translation(st.pos) @ rot_mat.to_4x4() @ mathutils.Matrix.Diagonal((36.0, 36.0, 36.0, 1.0))

    # ── 6. DYNAMIC THROTTLE RESPONSE ──────────────────────────────────────────
    if st.inp_throttle_up:
        st.throttle_pct = min(100.0, st.throttle_pct + 40.0 * dt)
    elif st.inp_throttle_down:
        st.throttle_pct = max(30.0, st.throttle_pct - 40.0 * dt)

    target_rpm = 3800.0 + (st.throttle_pct / 100.0) * (5800.0 - 3800.0)
    st.rpm += (target_rpm - st.rpm) * min(1.0, 4.0 * dt)

    # Dynamic airspeed based on throttle setting and dive gravity assist
    target_speed = 500.0 + (st.throttle_pct / 100.0) * (1300.0 - 500.0)
    st.speed_ms += (target_speed - st.speed_ms) * min(1.0, 2.5 * dt)
    # Gravity speed gain/loss during pitch
    st.speed_ms = max(400.0, min(1450.0, st.speed_ms - sin_pit * 250.0 * dt))

    # ── 7. ROTAX 912 iS FIRST-PRINCIPLES THERMODYNAMIC TWIN ───────────────────
    st.altitude_m = st.pos.z
    st.altitude_ft = st.altitude_m * 3.28084
    st.heading_deg = (math.degrees(st.heading_rad) + 360.0) % 360.0
    st.airspeed_kias = (st.speed_ms / CRUISE_SPEED_MS) * 132.0

    # 1. Atmospheric ISA lapse rate: cold mountain air
    t_amb = 15.0 - 0.0065 * st.altitude_m
    # 2. Relative air density rho(z) (thin at 5,800m, dense in canyon gorge)
    rho_rel = max(0.35, (1.0 - 0.0065 * st.altitude_m / 288.15) ** 4.256)

    # 3. Engine heat generation: combustion power scales non-linearly with RPM
    q_in = 24.0 * ((st.rpm / 5200.0) ** 2.4)

    # 4. Ram air convective cooling: function of air density, airspeed, and delta-T
    v_factor = max(0.2, (st.speed_ms / 950.0) ** 0.85)
    q_cool = 0.30 * rho_rel * v_factor * (st.cht_c - t_amb)

    # 5. Live Cylinder Head Temperature (CHT) physical integration
    st.cht_c = max(88.0, min(138.0, st.cht_c + ((q_in - q_cool) / 10.0) * dt))

    # 6. Coupled oil pressure (hot oil is thinner, cold oil is more viscous)
    st.oil_p_bar = max(3.5, min(5.0, 4.20 - 0.015 * (st.cht_c - 104.0)))
    st.fuel_flow_lh = 10.0 + (st.throttle_pct / 100.0) * 16.0

    # 7. Dynamic FADEC diagnostics and notifications
    if st.cht_c > 120.0 and not getattr(st, 'warn_cht_high', False):
        st.warn_cht_high = True
        st.add_log(f"[FADEC ALERT] CHT elevated ({st.cht_c:.1f}°C)! Thin air cooling limit. Dive or throttle down.", (1.0, 0.3, 0.3, 1.0))
    elif st.cht_c < 106.0 and getattr(st, 'warn_cht_high', False):
        st.warn_cht_high = False
        st.add_log(f"[THERMAL] Convective cooling nominal! CHT normalized to {st.cht_c:.1f}°C.", (0.0, 0.95, 0.4, 1.0))

    if st.altitude_m < 4200.0:
        st.mission_phase = "CANYON GORGE SPRINT (3,850m)"
    else:
        st.mission_phase = "HIGH CRUISE (5,800m)"


def update_chase_camera(st: FlightState):
    """Position Maverick Hero Chase Camera behind the pusher propeller."""
    cam = bpy.data.objects.get(CAM_NAME)
    if cam is None:
        return

    # Horizontal tail direction (opposite of heading)
    tail_dir = mathutils.Vector((-math.sin(st.heading_rad), -math.cos(st.heading_rad), 0.0)).normalized()
    up_vec = mathutils.Vector((0.0, 0.0, 1.0))

    # Ideal camera position: behind pusher prop and elevated
    ideal_cam_pos = st.pos + tail_dir * CAM_DIST_BEHIND + up_vec * CAM_HEIGHT_ABOVE

    # Smooth camera inertia
    if st.cam_world_pos is None:
        st.cam_world_pos = ideal_cam_pos.copy()
    else:
        st.cam_world_pos = st.cam_world_pos.lerp(ideal_cam_pos, CAM_LERP_FACTOR)

    cam.location = st.cam_world_pos

    # Look target: ahead of the aircraft nose
    fwd_horiz = -tail_dir
    look_target = st.pos + fwd_horiz * CAM_LOOK_AHEAD + up_vec * 15.0
    cam_dir = (look_target - cam.location).normalized()
    if cam_dir.length > 0.01:
        cam_rot = cam_dir.to_track_quat('-Z', 'Y')
        cam.rotation_euler = cam_rot.to_euler()


def _trigger_crash_event(st: FlightState, uav):
    """Halt simulation and capture crash telemetry card."""
    if st.is_crashed:
        return
    st.is_crashed = True
    st.crash_info = {
