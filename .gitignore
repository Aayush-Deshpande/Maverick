#   ollama pull qwen3:4b-instruct-2507-q4_K_M
Qwen3-4B/

# Scratch transient heavy blends (>100MB)
scratch/phase_c_blends/

# Large model weights / voice assets — excluded from Maverick push (size/LFS quota)
/Voice/
/Qwen3-4B/

# Competitor repos cloned for audit — not our code, never commit
competitors/

# Local LLM weights vendored for tooling — too large for GitHub/LFS quota
/vendor/Qwen3-4B/

# Local TTS voice assets vendored for tooling — contains a 327MB .pth over GitHub's
# 100MB non-LFS limit; keep excluded like the old /Voice/ rule did before the move.
/vendor/Voice/

# NASA ACES raw archives + extracted .mat (≈2GB, re-downloadable from GHRC DAAC
