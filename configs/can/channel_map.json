    "vibration_orders.1X": ["ANU_VIB_STATUS", "VibFirstOrder"],
    "vibration_orders.2X": ["ANU_VIB_STATUS", "VibFiringOrder"],
    "gearbox_t": ["ANU_VIB_STATUS", "GearboxTemperature"]
  }
