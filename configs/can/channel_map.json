    "fuel_p": ["ANU_FUEL_ELEC", "FuelPressure"],
    "rail_p": ["ANU_FUEL_ELEC", "RailPressure"],
    "bus_v": ["ANU_FUEL_ELEC", "BusVoltage"],
    "bus_i": ["ANU_FUEL_ELEC", "BusCurrent"],
    "batt_i": ["ANU_FUEL_ELEC", "BatteryCurrent"],
