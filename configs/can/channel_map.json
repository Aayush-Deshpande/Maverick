    "egt.0": ["ANU_EGT", "Egt1"], "egt.1": ["ANU_EGT", "Egt2"], "egt.2": ["ANU_EGT", "Egt3"], "egt.3": ["ANU_EGT", "Egt4"],
    "oil_p": ["ANU_FLUID", "OilPressure"],
    "oil_t": ["ANU_FLUID", "OilTemperature"],
