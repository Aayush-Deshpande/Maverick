{
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npx tsc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_commands.py\"",
            "timeout": 10,
            "statusMessage": "Checking command against repo guard rules"
          }
        ]
      }
    ]
  }
}
