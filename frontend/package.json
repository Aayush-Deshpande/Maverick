{
  "name": "rotax-digital-twin-mobile-gcs",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "sync-models": "node -e \"const fs=require('fs'); const p='../scripts/assets/sync_web_models.mjs'; if(fs.existsSync(p)){ require('child_process').execSync('node ' + p + ' frontend', {stdio:'inherit'}); } else { console.log('[sync_web_models] skipped (standalone build)'); }\"",
    "predev": "npm run sync-models",
    "prebuild": "npm run sync-models",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gen:types": "json2ts -i ../configs/schema/state.schema.json -o src/api/state.ts --bannerComment \"/* Generated from configs/schema/state.schema.json by npm run gen:types (card M0-05). Do not edit. */\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.3.0",
    "three": "^0.169.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "json-schema-to-typescript": "^16.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "3.2.7"
  }
}
