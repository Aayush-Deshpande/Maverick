# ==============================================================================
# ANUMAAN / DRDO PS-26054 — Aero-Engine Digital Twin Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local or cloud runs.
# NEVER commit .env to version control.
#
# Supported LLM providers:
#   ANUMAAN_LLM_PROVIDER=none        # Default: deterministic rule-based copilot (no LLM, DRDO baseline)
#   ANUMAAN_LLM_PROVIDER=gemini      # Cloud agent for hosted demonstration (requires GEMINI_API_KEY)
#   ANUMAAN_LLM_PROVIDER=qwen        # Local research / dev opt-in via Ollama (e.g. qwen2.5:7b-instruct)
#   ANUMAAN_LLM_PROVIDER=sarvam      # Indigenous open model via Ollama (Sarvam-30B, Apache-2.0)
#   ANUMAAN_LLM_PROVIDER=bharatgen   # Indigenous open model via Ollama (BharatGen Param2, MoE-17B)
# ==============================================================================

# --- Server & Runtime Environment ---
PYTHONUTF8=1
PYTHONUNBUFFERED=1
PORT=8000
# Runtime output directory (telemetry logs, blackbox recordings, session buffers)
# On Windows/local: leave as "var" or unset (defaults to <repo>/var)
# In Docker/Render: "/app/var"
ANUMAAN_VAR_DIR=var

# --- Active AI Copilot Provider ---
ANUMAAN_LLM_PROVIDER=none

# --- Google Gemini Cloud Agent (Active when ANUMAAN_LLM_PROVIDER=gemini) ---
# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-flash-lite-latest

# --- Local Ollama Engine (Active when ANUMAAN_LLM_PROVIDER=qwen / sarvam / bharatgen) ---
OLLAMA_HOST=http://localhost:11434
# Optional custom models path (e.g. on Windows D: drive: D:\AI\ollama\models)
# OLLAMA_MODELS=D:\AI\ollama\models
# Optional model override (e.g. qwen2.5:7b-instruct)
# ANUMAAN_LLM_MODEL_ID=qwen2.5:7b-instruct
# QWEN_NUM_CTX=4096
# QWEN_MAX_NEW_TOKENS=320
# QWEN_ENABLE_THINKING=0
# QWEN_KEEP_ALIVE=30m

# --- Command Security & Access Control (DECISIONS D52, Card M0-08) ---
# When set, every command endpoint (faults, levers, /api/control) requires header X-ANUMAAN-Token: <value>
# ANUMAAN_API_TOKEN=
# Allowed browser origins, comma-separated. Without it, only local dev origins are accepted.
# ANUMAAN_CORS_ORIGINS=https://www.midnight-ciphers.in
