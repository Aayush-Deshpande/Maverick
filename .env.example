# ==============================================================================
# ANUMAAN / DRDO PS-26054 — Aero-Engine Digital Twin Environment Configuration
# ==============================================================================
# Shipped Default: ANUMAAN_LLM_PROVIDER=none (per docs/build/DECISIONS.md D14)
#
# Supported local LLM providers (via Ollama):
#   ANUMAAN_LLM_PROVIDER=none        # Default: deterministic rule-based copilot (no LLM, DRDO baseline)
#   ANUMAAN_LLM_PROVIDER=sarvam      # Indigenous open model (Sarvam-30B, Apache-2.0)
#   ANUMAAN_LLM_PROVIDER=bharatgen   # Indigenous open model (BharatGen Param2, MoE-17B)
#   ANUMAAN_LLM_PROVIDER=qwen        # Local research / dev opt-in only (e.g. qwen2.5:1.5b / 7b)
# ==============================================================================

ANUMAAN_LLM_PROVIDER=none

# Optional model override (leave commented to use provider default)
# ANUMAAN_LLM_MODEL_ID=

# Context window and generation limits
# QWEN_NUM_CTX=4096
# QWEN_MAX_NEW_TOKENS=320
# QWEN_ENABLE_THINKING=0
# QWEN_KEEP_ALIVE=30m
